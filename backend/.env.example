# ServerHub backend (keep real values in backend/.env or hosting variables)
PORT=4000
NODE_ENV=development
ALLOW_EXPO_GO_REDIRECTS=false

# OAuth application from Discord Developer Portal
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-serverhub-api.example/api/auth/discord/callback
DISCORD_GUILD_ID=

# Existing Discord bot's protected dashboard endpoint
BOT_API_URL=https://your-discord-bot.example/api/serverhub/dashboard
BOT_API_TOKEN=

# Origins allowed to call this backend from a browser (comma-separated).
# Native app requests may not send an Origin header.
APP_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,https://your-serverhub-app.example
